{
  "name": "axiomops-ai",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "simulator"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx scripts/eval.ts",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:simulator": "npm --workspace=simulator run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build": "npm run --workspaces --if-present build"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "prisma": "^6.3.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
