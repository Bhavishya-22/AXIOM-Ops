# Database connection (PostgreSQL - Neon / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/axiomops?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://user:password@localhost:5432/axiomops?schema=public"

# Tokens
INGEST_TOKEN="ingest_secret_token_123"
CONTROL_TOKEN="control_secret_token_456"

# LLM Configuration
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-1.5-pro"
LLM_API_KEY="your-llm-api-key-here"

# Service endpoints
SIMULATOR_URL="http://localhost:4000"

# Application Environment
NODE_ENV="development"
PORT="3000"
